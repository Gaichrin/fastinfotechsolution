# GitHub Pages frontend build variables
#
# For this project page, https://gaichrin.github.io/fastinfotechsolution/
# use VITE_BASE_PATH=/fastinfotechsolution/
#
# For a user/organization page such as https://your-user.github.io/
# use VITE_BASE_PATH=/
VITE_BASE_PATH=/fastinfotechsolution/

# Hostinger PHP backend origin. Keep /api out of this value.
# The app will call ${VITE_API_BASE_URL}/api/availability, /api/contact, and /api/appointments.
VITE_API_BASE_URL=https://forestgreen-fish-476599.hostingersite.com/FITS/index.php
