# Hostinger PHP backend variables

# Public frontend URL on GitHub Pages. Used for CORS.
FRONTEND_URL=https://your-github-user.github.io/FITS
CORS_ALLOWED_ORIGINS=https://your-github-user.github.io

# Public backend URL on Hostinger. Used for absolute calendar invite URLs.
SITE_URL=https://api.your-domain.com

CONTACT_TARGET_EMAIL=your-business-email@example.com
MAIL_FROM_EMAIL=your-business-email@example.com

# SMTP account for contact and appointment emails.
JDCL_SMTP_HOST=smtp.hostinger.com
JDCL_SMTP_PORT=587
JDCL_SMTP_USERNAME=your-business-email@example.com
JDCL_SMTP_PASSWORD=your-email-password
JDCL_SMTP_ENCRYPTION=tls
JDCL_SMTP_FROM_EMAIL=your-business-email@example.com
JDCL_SMTP_FROM_NAME=Fast Infotech Solution

APPOINTMENT_TIMEZONE=Asia/Kolkata
APPOINTMENT_DURATION_MINUTES=30
APPOINTMENT_MIN_NOTICE_MINUTES=180
APPOINTMENT_WINDOW_DAYS=14

# Use the MySQL credentials created in Hostinger hPanel.
APPOINTMENT_DB_HOST=localhost
APPOINTMENT_DB_PORT=3306
APPOINTMENT_DB_NAME=u123456789_fits_appointments
APPOINTMENT_DB_USER=u123456789_fits_app
APPOINTMENT_DB_PASSWORD=replace-with-hostinger-db-password

APPOINTMENT_WORKDAY_START=11:00
APPOINTMENT_WORKDAY_END=16:30
APPOINTMENT_WORKING_DAYS=1,2,3,4,5
APPOINTMENT_BUFFER_MINUTES=0
APPOINTMENT_PHYSICAL_LOCATION=Fast Infotech Solution office
APPOINTMENT_EMAIL_REMINDER_MINUTES=60
APPOINTMENT_POPUP_REMINDER_MINUTES=15
JITSI_BASE_URL=https://meet.jit.si
